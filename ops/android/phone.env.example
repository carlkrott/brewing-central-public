# Non-secret staged phone environment. Production adds the authoritative ingest verifier.
# All hostnames and IPs below are illustrative documentation values for the
# non-secret example file; replace with your own staging topology before use.
#
# Path placeholders below assume the standard Termux layout. `<TERMUX_APP_ROOT>`
# resolves to the Termux app's private home directory (the conventional
# `com.termux` Termux package layout); the `brewing-central` subtree is the
# standard installation root. On a Termux runtime `~/brewing-central` expands
# identically. Override via the explicit env vars below when the deployment
# uses a different layout.
ISPINDEL_MODE=development
TAILNET_FQDN=phone.example.test
PHONE_BIND_IP=127.0.0.1
SQLITE_PATH=<TERMUX_APP_ROOT>/brewing-central/data/ispindel.db
BREW_SQLITE_PATH=<TERMUX_APP_ROOT>/brewing-central/data/brew.db
BATTERY_EVIDENCE_PATH=<TERMUX_APP_ROOT>/brewing-central/data/battery-state.json
HEARTBEAT_EVIDENCE_PATH=<TERMUX_APP_ROOT>/brewing-central/data/heartbeat.json
ZEROCLAW_URL=http://127.0.0.1:3100
ZEROCLAW_TOKEN_FILE=<TERMUX_APP_ROOT>/brewing-central/secrets/zeroclaw-token
ZEROCLAW_TIMEOUT_SECONDS=180
ASSISTANT_STRUCTURED_MODEL_URL=http://gemma.example.test:8095
ASSISTANT_STRUCTURED_MODEL_TIMEOUT_S=120
SEARXNG_SEARCH_URL=http://search.example.test:8080/search
KIWIX_SEARCH_URL=http://kiwix.example.test:9090/search
KIWIX_CONTENT_NAME=wikipedia_en_all_maxi_2026-02
CAMERA_OBSERVER_ENABLED=true
CAMERA_DEVICE_ID=12345678
CAMERA_SNAPSHOT_URL=http://127.0.0.1:8080/shot.jpg
CAMERA_MODEL_URL=http://gemma.example.test:8090/v1/chat/completions
CAMERA_MODEL=gemma
CAMERA_RETENTION_DAYS=30
CAMERA_IMAGE_DIR=<TERMUX_APP_ROOT>/brewing-central/data/camera
# W6 phone-health evidence loop interval (seconds). Bounded by phone-health-loop.sh
# to the (1, 3600] range; default 300 seconds (5 minutes).
PHONE_EVIDENCE_INTERVAL_SECONDS=300
PYTHONDONTWRITEBYTECODE=1
