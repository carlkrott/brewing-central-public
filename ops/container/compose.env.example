# Example environment file for the ispindel-dashboard Compose stack.
#
# Copy this file to compose.env and edit locally. NEVER commit compose.env
# (it is excluded by .gitignore via the generic .env rules). Do not place
# production secrets, real overlay-network addresses, or live hostnames here.
#
# The values below are illustrative defaults only; docker-compose.yml also
# defines its own in-file defaults for image_ref / container_name / mode.

# ----- Required by docker-compose.yml (compose refuses to start without these) -----

# Host group that owns the bind-mounted /health-evidence and /run/secrets dirs.
# The image's runtime UID 10001 must be a member of this group so it can read
# (but not write) those mounts. Locally any non-zero GID works; production
# binds a dedicated read-only GID on the host.
ISPINDEL_GID=10001

# Host directory containing battery/heartbeat evidence written by the producer.
# Mounted read-only at /health-evidence inside the container.
ISPINDEL_EVIDENCE_DIR=./local-state/health-evidence

# Host directory holding ingest-tokens.json and any related read-only secrets.
# Mounted read-only at /run/secrets inside the container.
ISPINDEL_SECRETS_DIR=./local-state/secrets

# ----- Optional overrides (defaults match docker-compose.yml's in-file defaults) -----

# Image reference. Local builds tag as ispindel-dashboard:dev; production
# pins a digest like ispindel-dashboard@sha256:<64-hex>.
# ISPINDEL_IMAGE_REF=ispindel-dashboard:dev

# Container name. Leave unset to let Compose derive a unique name.
# ISPINDEL_CONTAINER_NAME=ispindel-dashboard

# Named volume for /data. Defaults to <project>_ispindel-data when unset,
# which is the historical production binding.
# ISPINDEL_DATA_VOLUME=ispindel-dashboard_ispindel-data

# Published host:port -> container:port mapping for the dashboard API.
# Default binds the container's 8098 to the host loopback only (e.g.
# <loopback-addr>:<host-port>:8098). Leave unset to use the in-file default.
# ISPINDEL_BACKEND_PUBLISH=<loopback-addr>:<host-port>:8098

# Single backup-health evidence file written by scripts/backup-production.py
# after off-host verification and directory promotion. The dashboard binds
# this file (mode 0o644) read-only; the database generations directory is
# deliberately NOT mounted. Uncomment to override the local default.
# ISPINDEL_BACKUP_HEALTH_FILE=./local-state/backup-health/backup_health.json

# Runtime mode flag forwarded as ISPINDEL_MODE. Leave unset for production.
# ISPINDEL_MODE=production

# Whether the admin secret has been wired through the read-only secret mount.
# Leave unset (false) until ingest-tokens.json is in ISPINDEL_SECRETS_DIR.
# ISPINDEL_ADMIN_CONFIGURED=false