[Unit]
Description=Verify persistent iSpindel production credentials before boot
Before=ispindel-stack.service
After=local-fs.target
ConditionPathIsDirectory=/etc/ispindel

[Service]
Type=oneshot
EnvironmentFile=/etc/ispindel/production.env
ExecStart=/usr/bin/python3 /usr/local/libexec/ispindel/verify-production-secrets.py
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
