[Unit]
Description=Fleet-side phone-aware iSpindel backup via run-as+exec-out ADB
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
User=ispindel
Group=ispindel
EnvironmentFile=/etc/ispindel/phone-backup.env
Environment=ISPINDEL_PHONE_BACKUP_ROOT=/var/backups/ispindel-dashboard
Environment=ISPINDEL_PHONE_OFFHOST_ROOT=/var/backups/ispindel-dashboard/offhost
Environment=ISPINDEL_PHONE_HEALTH_ROOT=data/backup_health.json
Environment=ISPINDEL_PHONE_LOCK_PATH=/var/run/ispindel/phone-backup.lock
Environment=ISPINDEL_PHONE_LOCK_WAIT_SECONDS=5
ExecStart=/usr/bin/python3 /opt/ispindel-dashboard/scripts/backup-phone.py \
  --serial=${ISPINDEL_PHONE_SERIAL} \
  --backup-root=${ISPINDEL_PHONE_BACKUP_ROOT} \
  --offhost-root=${ISPINDEL_PHONE_OFFHOST_ROOT} \
  --run-id=auto \
  --lock-path=${ISPINDEL_PHONE_LOCK_PATH} \
  --lock-wait-seconds=${ISPINDEL_PHONE_LOCK_WAIT_SECONDS} \
  --health-relative=${ISPINDEL_PHONE_HEALTH_ROOT} \
  --execute
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/backups/ispindel-dashboard /var/run/ispindel
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal